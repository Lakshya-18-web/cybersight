# Copy to .env.integrations (git-ignored). PLACEHOLDERS ONLY here: never put a real key in this example file, in a compose file, in an image or in a log.
# Everything in this file is optional. It never changes the model switches or the Gemini key; those stay wherever you keep them today.

# --- Gemini (live model) -----------------------------------------------------------------------------------------------------------------------------
# This file deliberately does NOT contain GEMINI_API_KEY, WEEK5_MODEL_MODE or WEEK5_ALLOW_LIVE_MODEL. When two --env-file options define the same name the LATER file wins, so an empty or default line
# here would silently replace the real key or the live-mode switch you already keep in .env.week5 / your compose file. Leave those three where they are.
# WEEK5_WITH_GENAI=1 keeps the Gemini client library in the image on every rebuild (the build fails if the library cannot be imported). Set it to 0 only for an image that never talks to Gemini.
WEEK5_WITH_GENAI=1

# --- AbuseIPDB (threat intelligence, optional) ---------------------------------------------------------------------------------------------------------
# Used only for alerts that came from a sensor (WEEK5_TI_ALERT_SETS=sensor). Leave the key empty to disable lookups; the pipeline then labels enrichment "disabled" and carries on.
SOC_REPUTATION_API_KEY=
SOC_REPUTATION_TIMEOUT=5
WEEK5_TI_ALERT_SETS=sensor
WEEK5_TI_DAILY_BUDGET=500

# --- Egress allow-list ---------------------------------------------------------------------------------------------------------------------------------
# Hosts the proxy will tunnel to (exact names, port 443). Do not add anything else.
WEEK5_EGRESS_ALLOW=generativelanguage.googleapis.com,api.abuseipdb.com
WEEK5_EGRESS_MAX_TUNNELS=32
