# Copy to .env.week4 (git-ignored) and fill in. Never commit real values.
# Docker Compose (docker-compose.yml)
WEEK4_DB_OWNER=soc_owner
WEEK4_DB_PASSWORD=<choose-a-long-random-password>
WEEK4_DB_NAME=soc
WEEK4_DB_PORT=5432

# Owner connection: migrations and admin commands only (python -m week4.db.migrate / week4.db.admin)
WEEK4_ADMIN_DATABASE_URL=postgresql://soc_owner:<owner-password>@127.0.0.1:5432/soc

# Least-privilege login used by the API and by ingest_cases.py (create it with: python -m week4.db.admin create-api-login)
WEEK4_API_DB_PASSWORD=<another-long-random-password>
WEEK4_DATABASE_URL=postgresql://soc_api_login:<api-password>@127.0.0.1:5432/soc

# API authentication: token hashes ("analyst_id:sha256hex", comma separated) from python -m week4.api.auth new-token
WEEK4_API_TOKEN_HASHES=
# or, on your own machine only (loopback; no real authentication): WEEK4_API_DEV_MODE=1

# Optional: another risk policy file (default config/risk_policy.json)
# WEEK4_RISK_POLICY=
