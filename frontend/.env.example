# Copy to .env.local for local development. There are no secrets here and there must never be: every VITE_ value is readable by anyone who opens the site.
# Where the browser sends API requests. Leave as /api when something on the same origin forwards it (Vite in development, nginx in Docker).
VITE_API_BASE_URL=/api
# Development only: where the Vite dev server forwards /api (not shipped in the bundle).
DEV_API_TARGET=http://127.0.0.1:8000
# Optional tuning (milliseconds).
VITE_JOB_POLL_MS=2000
VITE_HEALTH_POLL_MS=30000
