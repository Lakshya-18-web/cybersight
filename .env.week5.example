# Copy to .env.week5 (git-ignored) and fill in EVERY value. Never commit real values.
# Use URL-safe secrets (they are placed inside connection strings): generate each with
#     python -c "import secrets; print(secrets.token_hex(24))"
# Use a different value for each line. Compose refuses to start when a required value is missing.

# PostgreSQL owner account (used by the postgres container and the one-shot migrate job only)
WEEK5_DB_OWNER=soc_owner
WEEK5_DB_PASSWORD=<generated-secret-1>
WEEK5_DB_NAME=soc

# Least-privilege logins created by the migrate job. The API uses soc_api_login, workers use soc_worker_login.
WEEK4_API_DB_PASSWORD=<generated-secret-2>
WEEK5_WORKER_DB_PASSWORD=<generated-secret-3>

# Redis password (queue messages only; not persisted)
WEEK5_REDIS_PASSWORD=<generated-secret-4>

# API authentication: "analyst_id:sha256hex" pairs, comma separated, from:  python -m week4.api.auth new-token --analyst alice
# (the token itself is shown once and is never stored; only the hash goes here)
WEEK4_API_TOKEN_HASHES=

# Optional overrides (defaults shown)
# WITH_GENAI=0                          1 installs the live-model library into the image (still no live call unless WEEK5_ALLOW_LIVE_MODEL=1)
# WEEK5_API_PORT=8000
# WEEK5_MAX_ATTEMPTS=3
# WEEK5_JOB_TIMEOUT_SECONDS=60
# WEEK5_MAX_QUEUE_DEPTH=1000
# WEEK5_RATE_LIMIT_PER_MINUTE=120

# Web sign-in (username + password; docs/AUTHENTICATION.md). Defaults shown; none of these is a secret except WEEK5_BOOTSTRAP_TOKEN.
# WEEK5_WEB_AUTH=1                      0 turns the sign-in routes off (bearer tokens only)
# WEEK5_ALLOWED_ORIGINS=https://cybersight-nine.vercel.app     exact console origin(s), comma separated; no wildcard
# WEEK5_COOKIE_SECURE=1                 0 only for local development over plain http (then also WEEK5_COOKIE_SAMESITE=Lax)
# WEEK5_COOKIE_SAMESITE=None            None (console and API on different sites), Lax or Strict
# WEEK5_SESSION_IDLE_SECONDS=43200      12 hours of inactivity ends a session
# WEEK5_SESSION_ABSOLUTE_SECONDS=604800 7 days at most
# WEEK5_PASSWORD_HASH=argon2id          argon2id (default) or scrypt
# WEEK5_TRUSTED_PROXY_HOPS=1            reverse proxies in front of the API that append to X-Forwarded-For (1 = nginx in Docker; 2 = Vercel /api proxy in front of Render)
# WEEK5_ALLOW_BEARER_TOKENS=1           0 = browser sessions only (set this once no machine client needs an API token)
# One-time setup of the FIRST administrator: set this to a random value (python -c "import secrets; print(secrets.token_urlsafe(48))"), open the console's setup page, then REMOVE it again.
# WEEK5_BOOTSTRAP_TOKEN=
