+def trace_alert(tracer, record, calls, say=print):
+    """Tracing must never change a run: any error is counted and printed, and the run goes on."""
+    if tracer is None:
+        return
+    try:
+        tracer.record_alert(record, calls)
+    except Exception as error:
+        tracer.errors = getattr(tracer, "errors", 0) + 1
+        say("tracing error (the run continues): " + type(error).__name__ + ": " + str(error)[:120])
+
